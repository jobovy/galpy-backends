+def graft_jacobian(xp, value, primals, jac_rows):
+    r"""First-order analytic-gradient graft (stop_gradient reparameterisation).
+
+    The same construction as ``galpy.backend.optimize.bisect_root``: keeps the
+    forward value of ``value`` and replaces its gradient with the supplied
+    analytic Jacobian ``jac_rows[i] = dvalue/dprimals[i]``, via
+    ``sg(value) + sum_i sg(jac_rows[i]) * (primals[i] - sg(primals[i]))`` where
+    ``sg`` is ``stop_gradient``. Every ``primals[i] - sg(primals[i])`` is 0 at the
+    primal, so the value is unchanged; the first derivative becomes the analytic
+    chain rule. First-order only (the Jacobian is stop_gradient-ed, so second and
+    higher derivatives are 0).
+    """
+    out = stop_gradient(value)
+    for primal, jac in zip(primals, jac_rows):
+        out = out + stop_gradient(jac) * (primal - stop_gradient(primal))
+    return out
+
+
