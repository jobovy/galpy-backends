From 8a513fb57883685b006234d35292c0c8c27eee8c Mon Sep 17 00:00:00 2001
From: jobovy-agent <jo.bovy+agent@gmail.com>
Date: Mon, 21 Sep 2026 08:58:00 -0400
Subject: [PATCH] CI: run the backend suite TRACED on every PR, as a matrix
 axis

--jit had no automatic run at all. It was reachable only through
workflow_dispatch, and the weekly cron cannot help: GitHub only schedules
workflows from the DEFAULT branch, and .github/workflows/backend-tests.yml does
not exist on main -- `gh run list --event=schedule` for it returns nothing, so
that cron has never fired once. The jax-jit / torch-jit burndown was therefore
validated locally and never by CI: a traced gap could appear, or a fixed one
regress, with nothing noticing.

So traced mode becomes a third cross-product axis rather than a schedule:

    BACKEND: [jax, torch]
    MODE:    [eager, jit]      <- new
    TEST_FILES: [... 22 shards ...]

It rides the same push / pull_request triggers as eager, which is the point --
a traced gap now shows up on the PR that introduces it. 44 jobs -> 88. The
180-minute timeout was already sized for a traced shard.

`include:` keys on TEST_FILES only, so each REQUIRES_* dependency flag merges
into BOTH modes of its shard.

Artifact naming had to change with it. Eager and traced run the SAME
{BACKEND, shard} pair, so both halves would have uploaded
backend-junit-<backend>-<sid> inside ONE run; download-artifact keeps only one
of a duplicated name, which would have silently halved the status report. The
junit file and the artifact now carry the mode: backend-junit-<backend>[-jit]-
<sid>.

backend_status_report.py grows the two traced columns to match. match_cell
anchors on an exact backend-junit-<backend>-<sid> prefix, so the eager columns
cannot pick up a -jit artifact -- verified per column, including the
pytest-split _g<N> merge. The "<backend>-jit" keys are also what conftest
writes into the xfail ledger, so the per-backend ledger accounting now lines up
with the columns instead of ignoring the traced entries.

Expect the first run to be red: jit has never run in CI, so it will surface
genuine traced-only gaps. That is the point, and the ledger keys it separately
from the eager lists so the burndown does not mix them.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MgPfLBMhm6aEYwVtaQ7jMm
---
 .github/workflows/backend-tests.yml | 36 ++++++++++++++++++++++-------
 tests/backend_status_report.py      |  6 ++++-
 2 files changed, 33 insertions(+), 9 deletions(-)

diff --git a/.github/workflows/backend-tests.yml b/.github/workflows/backend-tests.yml
index b8c39d865..634828a20 100644
--- a/.github/workflows/backend-tests.yml
+++ b/.github/workflows/backend-tests.yml
@@ -97,7 +97,9 @@ jobs:
   # ordinary pushes/PRs elsewhere in the repo; the job-level `if` additionally
   # pins the PR case to those two base branches.
   backend-suite:
-    name: backend ${{ matrix.BACKEND }} ${{ matrix.TEST_FILES }}
+    # The -jit suffix keeps the traced half of the matrix distinguishable from
+    # the eager half in the checks list and in the status report.
+    name: backend ${{ matrix.BACKEND }}${{ (matrix.MODE == 'jit' || github.event.inputs.jit == 'true') && '-jit' || '' }} ${{ matrix.TEST_FILES }}
     runs-on: ubuntu-latest
     # Backstop: even with the per-test --timeout below, cap the whole shard so a
     # pathological accumulation of slow tests can't keep the report job waiting.
@@ -131,6 +133,18 @@ jobs:
         # duplicated multi-python / macOS orbit shards are not repeated (one
         # ubuntu orbit shard each).
         BACKEND: [jax, torch]
+        # THIRD cross-product axis: every {BACKEND, TEST_FILES} shard runs both
+        # eager and TRACED (jax.jit / torch.compile at each galpy entry point).
+        # Traced mode previously had no automatic run at all -- --jit was
+        # reachable only through workflow_dispatch, and the weekly cron below
+        # has never fired because GitHub only schedules workflows from the
+        # DEFAULT branch and this file does not exist on main. So the jax-jit /
+        # torch-jit burndown was validated locally and never by CI. As an axis
+        # it rides the same push/pull_request triggers as eager, which is the
+        # point: a traced gap now shows up on the PR that introduces it.
+        # `include:` below keys on TEST_FILES only, so each REQUIRES_* flag
+        # merges into BOTH modes of that shard.
+        MODE: [eager, jit]
         TEST_FILES:
           - tests/test_actionAngle.py
           - tests/test_sphericaldf.py
@@ -300,20 +314,26 @@ jobs:
       env:
         TEST_FILES: ${{ matrix.TEST_FILES }}
         BACKEND: ${{ matrix.BACKEND }}
+        # eager and traced run the SAME {BACKEND, shard} pair, so the junit
+        # name has to carry the mode or the two halves of the matrix collide on
+        # one artifact name inside a single run and download-artifact keeps
+        # only one of them (silently halving the report).
+        BACKEND_TAG: ${{ matrix.BACKEND }}${{ (matrix.MODE == 'jit' || github.event.inputs.jit == 'true') && '-jit' || '' }}
       run: |
         SHARD_ID=$(python tests/backend_status_report.py --id)
         echo "SHARD_ID=${SHARD_ID}" >> "$GITHUB_ENV"
-        echo "JUNIT_PATH=${GITHUB_WORKSPACE}/backend-junit-${BACKEND}-${SHARD_ID}.xml" >> "$GITHUB_ENV"
+        echo "BACKEND_TAG=${BACKEND_TAG}" >> "$GITHUB_ENV"
+        echo "JUNIT_PATH=${GITHUB_WORKSPACE}/backend-junit-${BACKEND_TAG}-${SHARD_ID}.xml" >> "$GITHUB_ENV"
     - name: Test with pytest (backend=${{ matrix.BACKEND }})
       env:
         TEST_FILES: ${{ matrix.TEST_FILES }}
         BACKEND: ${{ matrix.BACKEND }}
-        # workflow_dispatch(jit=true): trace every galpy entry point instead of
-        # running eager. Same shards, same ledger machinery -- conftest keys the
+        # The MODE axis, or workflow_dispatch(jit=true) which forces every
+        # shard traced. Same shards, same ledger machinery -- conftest keys the
         # burndown lists "<backend>-jit" so traced gaps stay separate from eager
-        # ones. Dispatch-only for now: tracing costs roughly what eager jax does
-        # again, and the eager jax matrix already sits near the session timeout.
-        JIT_FLAG: ${{ github.event.inputs.jit == 'true' && '--jit' || '' }}
+        # ones. Tracing costs roughly what eager jax does again, which is what
+        # the 180-minute timeout above is sized for.
+        JIT_FLAG: ${{ (matrix.MODE == 'jit' || github.event.inputs.jit == 'true') && '--jit' || '' }}
       run: |
         # -rxX reports XFAIL/XPASS; junit xml drives the burndown summary and the
         # report job's per-file table. Do NOT pass -W error here: under a backend
@@ -436,7 +456,7 @@ jobs:
       if: ${{ always() }}
       uses: actions/upload-artifact@v4
       with:
-        name: backend-junit-${{ matrix.BACKEND }}-${{ env.SHARD_ID }}
+        name: backend-junit-${{ env.BACKEND_TAG }}-${{ env.SHARD_ID }}
         path: ${{ env.JUNIT_PATH }}
         if-no-files-found: warn
     - name: Upload regenerated ledger (regen mode)
diff --git a/tests/backend_status_report.py b/tests/backend_status_report.py
index e3fc0d899..a2370e255 100755
--- a/tests/backend_status_report.py
+++ b/tests/backend_status_report.py
@@ -66,7 +66,11 @@ import sys
 import xml.etree.ElementTree as ET
 from dataclasses import dataclass
 
-BACKENDS = ["jax", "torch"]
+# Four columns, not two: the backend-suite matrix runs every shard eager AND
+# traced, uploading backend-junit-<backend>[-jit]-<sid>.xml. The "-jit" keys
+# are also what conftest writes into the xfail ledger, so the per-backend
+# ledger accounting below lines up with them.
+BACKENDS = ["jax", "torch", "jax-jit", "torch-jit"]
 
 # Canonical list of the 14 TEST_FILES shards, in matrix order, each with a
 # short human-readable label for the table rows. MUST stay in sync with the
