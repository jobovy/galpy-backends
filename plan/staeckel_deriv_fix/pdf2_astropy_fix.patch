+def _exit_cast(value, *inputs):
+    """Exit-cast a public physical/consumption output back to numpy unless the
+    caller passed a backend array (autodiff keeps backend arrays). Under a forced
+    backend a scalar/numpy call still computes on the backend, but astropy can't
+    hold a backend-array Quantity (#1052), so consumption outputs stay numpy."""
